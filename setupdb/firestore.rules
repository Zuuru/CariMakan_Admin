rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCustomer() {
      return isAuth() && getRole() == 'customer';
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    function isOwnerOf(restoId) {
      return isAuth() && get(/databases/$(database)/documents/restaurants/$(restoId)).data.owner_id == request.auth.uid;
    }

    // ─── users ─────────────────────────────────────────────────────────────
    // User hanya bisa baca/edit data diri sendiri. Admin bisa baca semua.

    match /users/{uid} {
      allow read: if isAuth() && (isSelf(uid) || isAdmin());
      allow create: if isAuth() && isSelf(uid);
      allow update: if isAuth() && isSelf(uid);
      allow delete: if isAdmin();
    }

    // ─── restaurants ───────────────────────────────────────────────────────
    // Publik bisa baca. Owner hanya bisa edit restorannya sendiri. Admin bisa semua.

    match /restaurants/{restoId} {
      allow read: if true;
      allow create: if isOwner();
      allow update: if isOwnerOf(restoId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── menus ─────────────────────────────────────────────────────────────
    // Publik bisa baca. Owner hanya bisa kelola menu restorannya sendiri.

    match /menus/{menuId} {
      allow read: if true;
      allow create: if isOwner() && isOwnerOf(request.resource.data.resto_id);
      allow update, delete: if isOwnerOf(resource.data.resto_id) || isAdmin();
    }

    // ─── meja ──────────────────────────────────────────────────────────────

    match /meja/{mejaId} {
      allow read: if isAuth();
      allow create: if isOwner() && isOwnerOf(request.resource.data.resto_id);
      allow update, delete: if isOwnerOf(resource.data.resto_id) || isAdmin();
    }

    // ─── orders ────────────────────────────────────────────────────────────
    // Customer hanya bisa baca ordernya sendiri. Owner bisa baca order di restonya.

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isOwnerOf(resource.data.resto_id) ||
        isAdmin()
      );
      allow create: if isCustomer();
      allow update: if (
        isOwnerOf(resource.data.resto_id) ||   // Owner update status pesanan
        (isCustomer() && resource.data.user_id == request.auth.uid && !resource.data.sudah_direview) // Customer submit review
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── order_items ───────────────────────────────────────────────────────

    match /order_items/{itemId} {
      allow read: if isAuth();
      allow create: if isCustomer();
      allow update, delete: if isAdmin();
    }

    // ─── payments ──────────────────────────────────────────────────────────
    // Dibuat oleh backend (via Admin SDK), bukan langsung dari client.

    match /payments/{paymentId} {
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if false; // Hanya backend (Admin SDK) yang boleh
      allow delete: if isAdmin();
    }

    // ─── badges ────────────────────────────────────────────────────────────

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── resto_badges ──────────────────────────────────────────────────────

    match /resto_badges/{docId} {
      allow read: if true;
      allow create, update: if isOwnerOf(request.resource.data.resto_id) || isAdmin();
      allow delete: if isOwnerOf(resource.data.resto_id) || isAdmin();
    }

    // ─── tag_kategori ──────────────────────────────────────────────────────

    match /tag_kategori/{katId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── review_tags ───────────────────────────────────────────────────────

    match /review_tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── order_review_tags ─────────────────────────────────────────────────

    match /order_review_tags/{docId} {
      allow read: if isAuth();
      allow create: if isCustomer();
      allow update, delete: if isAdmin();
    }

    // ─── promo_vouchers ────────────────────────────────────────────────────

    match /promo_vouchers/{promoId} {
      allow read: if isAuth();
      allow create: if isAdmin() || isOwner();
      allow update: if (
        isAdmin() ||
        (isOwner() && resource.data.created_by == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ─── reward_poin ───────────────────────────────────────────────────────
    // Dibuat oleh backend saja. Customer hanya bisa baca miliknya.

    match /reward_poin/{poinId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow create, update: if false; // Hanya backend (Admin SDK)
      allow delete: if isAdmin();
    }

  }
}
